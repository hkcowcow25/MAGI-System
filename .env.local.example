# MAGI System — environment template
# Copy to .env.local (or the path pointed to by MAGI_ENV_FILE)

# ── API gate (required for /v1/* cost-triggering routes) ──
MAGI_API_KEY=change-me-to-a-long-random-secret

# Deterministic mock deliberation without real LLM keys (dev/tests only).
# Production MUST leave this unset/false — missing keys will fail clearly.
MAGI_MOCK_MODE=false

# ── Docker / compose bind (optional) ──
# MAGI_HOST_BIND=127.0.0.1
# MAGI_PORT=3000
# MAGI_ENV_FILE=.env.local
# MAGI_DATA_VOLUME=magi-data
# Example LAN bind for Synology / NAS (use with reverse proxy + auth):
# MAGI_HOST_BIND=0.0.0.0

# ══════════════════════════════════════════
# Per-persona provider config
# Each of MELCHIOR / BALTHASAR / CASPER independently:
#   PROVIDER, MODEL, BASE_URL, API_KEY, SYSTEM_PROMPT,
#   TIMEOUT_MS, MAX_OUTPUT_TOKENS, TEMPERATURE
# Providers: openai | anthropic | google | openai-compatible | ollama
# (ollama is resolved as openai-compatible; default BASE_URL http://127.0.0.1:11434/v1)
# ══════════════════════════════════════════

# --- MELCHIOR-1 (default: OpenAI) ---
MELCHIOR_PROVIDER=openai
MELCHIOR_MODEL=gpt-4o-mini
MELCHIOR_API_KEY=
# MELCHIOR_BASE_URL=
# MELCHIOR_SYSTEM_PROMPT=
MELCHIOR_TIMEOUT_MS=60000
MELCHIOR_MAX_OUTPUT_TOKENS=1024
MELCHIOR_TEMPERATURE=0.3
# MELCHIOR_REASONING_EFFORT=low

# Legacy aliases still accepted for Melchior:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_REASONING_EFFORT=low

# --- BALTHASAR-2 (default: Anthropic) ---
BALTHASAR_PROVIDER=anthropic
BALTHASAR_MODEL=claude-haiku-4-5
BALTHASAR_API_KEY=
# BALTHASAR_BASE_URL=
# BALTHASAR_SYSTEM_PROMPT=
BALTHASAR_TIMEOUT_MS=60000
BALTHASAR_MAX_OUTPUT_TOKENS=1024
BALTHASAR_TEMPERATURE=0.3

# Legacy aliases:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# --- CASPER-3 (default: Google) ---
CASPER_PROVIDER=google
CASPER_MODEL=gemini-2.0-flash
CASPER_API_KEY=
# CASPER_BASE_URL=
# CASPER_SYSTEM_PROMPT=
CASPER_TIMEOUT_MS=60000
CASPER_MAX_OUTPUT_TOKENS=1024
CASPER_TEMPERATURE=0.3

# Legacy aliases:
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.0-flash

# ── Example: all three via LM Studio on a workstation (OpenAI-compatible) ──
# From Synology/NAS, use the workstation LAN IP, not localhost.
# MELCHIOR_PROVIDER=openai-compatible
# MELCHIOR_BASE_URL=http://192.168.1.50:1234/v1
# MELCHIOR_MODEL=local-model
# MELCHIOR_API_KEY=lm-studio
# BALTHASAR_PROVIDER=openai-compatible
# BALTHASAR_BASE_URL=http://192.168.1.50:1234/v1
# BALTHASAR_MODEL=local-model
# BALTHASAR_API_KEY=lm-studio
# CASPER_PROVIDER=openai-compatible
# CASPER_BASE_URL=http://192.168.1.50:1234/v1
# CASPER_MODEL=local-model
# CASPER_API_KEY=lm-studio

# ── Example: Ollama ---
# MELCHIOR_PROVIDER=ollama
# MELCHIOR_MODEL=llama3.2
# MELCHIOR_BASE_URL=http://127.0.0.1:11434/v1
